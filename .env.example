# Copy to .env and fill in. Only GEMINI_API_KEY is required.
GEMINI_API_KEY=

# ---- translation LLM: gemini | ollama | mock (mock = fake output for testing the app)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# cheaper model for pass 1 (summaries + glossary), word lookups and practice questions
GEMINI_UNDERSTAND_MODEL=gemini-3.5-flash-lite
# thinking for the translation model: low | medium | high, or empty to not send it
GEMINI_THINKING_LEVEL=low
# thinking for the cheaper model above
GEMINI_LIGHT_THINKING_LEVEL=minimal

# ---- Ollama (local) — set LLM_PROVIDER=ollama to use
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_NUM_CTX=16384

# ---- speed / size (defaults: gemini 8000 chars per call, 3 parts in parallel; ollama 2500, 1)
# TRANSLATE_BATCH_CHARS=8000
# UNDERSTAND_CHUNK_CHARS=24000
# CONCURRENCY=3

# ---- text-to-speech
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# interactions (current API) | generate_content (older *-preview-tts models)
GEMINI_TTS_API=interactions
TTS_VOICE=Kore
TTS_STYLE=warm, calm Sri Lankan storyteller reading a book aloud

# ---- Batch API mode: how often to check on running jobs
# BATCH_POLL_SECONDS=60

# ---- server
# HOST=127.0.0.1   (only this computer can open the app)
PORT=8000
# DATA_DIR=./data
